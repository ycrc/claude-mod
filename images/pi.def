Bootstrap: localimage
From: {{ base }}

# Pi on the shared base (images/base.def). Build with images/build.sh.

%arguments
    base=build/coding-agents-base.sif

%post
    set -eux

    # Unpinned, like the other harnesses: images/build.sh records the version
    # that shipped in versions.txt.
    npm install -g @earendil-works/pi-coding-agent
    npm cache clean --force

%test
    set -eu
    /usr/local/libexec/coding-agents-base-test.sh
    command -v pi
    pi --version
    # The launcher links Pi's bundled subagent extension from here
    # (YCRC_PI_SUBAGENT_EXT_DIR in coding-agents-provider.conf).
    ext=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/examples/extensions/subagent
    test -f "$ext/index.ts"
    test -f "$ext/agents.ts"

%labels
    Author YCRC
    Description Sandboxed Pi coding agent for the YCRC-local model
