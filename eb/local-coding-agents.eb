easyblock = 'Bundle'

name = 'local-coding-agents'
version = '1.2'

homepage = 'https://docs.ycrc.yale.edu/ai/aicodingtools/'
description = """Sandboxed Claude Code, OpenAI Codex CLI, GitHub Copilot CLI, and Pi for YCRC clusters."""

toolchain = SYSTEM

# Each harness is its own hidden module (eb/<harness>-local.eb) with its own
# image, so one can be upgraded without rebuilding the others. This module
# only loads all four; users see just local-coding-agents.
dependencies = [
    ('claude-local', version),
    ('codex-local', version),
    ('copilot-local', version),
    ('pi-local', version),
]
hiddendependencies = dependencies

# The model is named generically: it is served behind the ycrc-local alias and
# can change without a module rebuild.
modloadmsg = '\nSecure AI coding assistance for Bouchet using the YCRC-hosted local model with popular coding-agent interfaces. Code and prompts are processed locally without being sent to external AI providers.\n'
modloadmsg += '\nChoose a harness based on your workflow:\n'
modloadmsg += '  pi       - Fast & flexible (recommended)\n'
modloadmsg += '  copilot  - Consistent & structured\n'
modloadmsg += '  codex    - Precise & task-focused\n'
modloadmsg += '  claude   - Thorough & exploratory (slower)\n'
modloadmsg += '\nAdministrators: use the Claude harness only.\n'
modloadmsg += '\nAllocate a compute node before running, and start in a non-hidden subdirectory\n'
modloadmsg += 'of your home, project, scratch, or approved PI space.\n'
modloadmsg += '\nYour groups\' shared directories (<group>/shared) are available read-only.\n'
modloadmsg += 'To let the agent read other directories, add --bind DIR when starting it;\n'
modloadmsg += 'they are mounted read-only, for example:  pi --bind /path/to/data\n'

moduleclass = 'devel'
