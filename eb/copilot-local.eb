easyblock = 'Binary'

name = 'copilot-local'
version = '1.5'
# Loaded through local-coding-agents; not listed in `module avail`.
hidden = True

homepage = 'https://docs.ycrc.yale.edu/ai/aicodingtools/'
description = """Sandboxed GitHub Copilot CLI for the YCRC-local model. One of the four harness
modules bundled by local-coding-agents."""

toolchain = SYSTEM

# The launcher and shared configuration are the same files in every harness
# module (the launcher reads its configuration only from its own directory);
# the image and any harness configuration are this harness's own.
sources = [
    'coding-agents-copilot.sif',
    'coding-agents-wrapper.sh',
    'coding-agents-bind.conf',
    'coding-agents-path.conf',
    'coding-agents-exclude.conf',
    'coding-agents-env.conf',
    'coding-agents-provider.conf',
    'coding-agents-site.tar.gz',
]
checksums = [
    {'coding-agents-copilot.sif': '8ad51d2eb472f880099483ae6621f9fe249bec1d7e1de6b489be9cd329e6d387'},
    {'coding-agents-wrapper.sh': '302aeb2445a220f10c41613bf8c486640011755d8424b2ab2208e0c9eedf0fd5'},
    {'coding-agents-bind.conf': '8a6d6e371fc66c21a6d2896e4cb1a1c90a8f8c759c5731ccbdf16652428f9b3d'},
    {'coding-agents-path.conf': 'c44923cd72e95972195a2c520a2ada0dc6ef76ba184ba44af60b2a87f4665406'},
    {'coding-agents-exclude.conf': '3275d0d06d91a99107074f817daf60e176251a63bf64583d434ccefd6e049edb'},
    {'coding-agents-env.conf': '1eaa1d157f7b3166741f9d0e0631f2f33b3f2d319d48c584d470d8a4dff25f21'},
    {'coding-agents-provider.conf': '6dee8faed2d048f6a7a9d4061dc7c80c7758730178d750e3a500e61b1ff19c8b'},
    {'coding-agents-site.tar.gz': '70e9a40f99de7dcea336a72bdc9a131b28aabdf2d63a0ed08bf27f166e5f3567'},
]

postinstallcmds = [
    'install -m 0755 %(installdir)s/coding-agents-wrapper.sh %(installdir)s/copilot',
    'chmod 0644 %(installdir)s/coding-agents-bind.conf',
    'chmod 0644 %(installdir)s/coding-agents-path.conf',
    'chmod 0644 %(installdir)s/coding-agents-exclude.conf',
    'chmod 0644 %(installdir)s/coding-agents-env.conf',
    'chmod 0644 %(installdir)s/coding-agents-provider.conf',
    'mkdir -p %(installdir)s/share',
    'tar -xzf %(installdir)s/coding-agents-site.tar.gz -C %(installdir)s/share',
    'chmod -R a+rX %(installdir)s/share/agents',
]

modextrapaths = {'PATH': '.'}

sanity_check_paths = {
    'files': [
        'coding-agents-copilot.sif',
        'coding-agents-wrapper.sh',
        'coding-agents-bind.conf',
        'coding-agents-path.conf',
        'coding-agents-exclude.conf',
        'coding-agents-env.conf',
        'coding-agents-provider.conf',
        'coding-agents-site.tar.gz',
        'share/agents/AGENTS.md', 'share/agents/skills/bouchet-storage/SKILL.md',
        'share/agents/skills/bouchet-modules/SKILL.md',
        'share/agents/subagents/deep-reasoning.md',
        'share/agents/subagents/quick-task.md',
        'copilot',
    ],
    'dirs': ['share/agents/skills', 'share/agents/subagents'],
}

moduleclass = 'devel'
